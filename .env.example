TELEGRAM_BOT_TOKEN=replace-with-token-from-botfather
# Mandatory: comma-separated numeric Telegram user IDs the bot may answer.
# The bot refuses to start without it and denies everyone not listed.
# Find your ID from @userinfobot or the bot's denial message.
ALLOWED_USER_IDS=123456789
IMPORT_INTERVAL_HOURS=24
STALE_AFTER_HOURS=72
ENVIRONMENT=production
